# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# DO NOT include real passwords or keys here!
# Copy this file to `.env.prod` on your production server
# and fill in the actual values.

# -----------------
# Global Settings
# -----------------
NODE_ENV=production
PORT=80

# -----------------
# NGINX Proxy / Frontend URL
# -----------------
# The public URL where your frontend/API will be hosted (e.g. your domain or server IP)
NEXT_PUBLIC_API_GATEWAY_URL=http://tu-dominio.com

# -----------------
# Security
# -----------------
# Generate a strong random string (e.g., using `openssl rand -hex 32`)
JWT_SECRET=tu_secreto_super_seguro_y_largo_aqui

# -----------------
# MongoDB Settings
# -----------------
# Credentials for the MongoDB root user
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=super_secret_mongo_password

# Connection URIs for each service (using the internal docker network hostname `mongodb`)
MONGO_URI_AUTH=mongodb://admin:super_secret_mongo_password@mongodb:27017/FeelWeell_Auth?authSource=admin
MONGO_URI_AI=mongodb://admin:super_secret_mongo_password@mongodb:27017/FeelWeell_AIChat?authSource=admin
MONGO_URI_MOOD=mongodb://admin:super_secret_mongo_password@mongodb:27017/FeelWeell_MoodTracking?authSource=admin
MONGO_URI_HEALTHY=mongodb://admin:super_secret_mongo_password@mongodb:27017/FeelWeell_Healthy?authSource=admin
MONGO_URI_DAILY=mongodb://admin:super_secret_mongo_password@mongodb:27017/?authSource=admin

# -----------------
# RabbitMQ Settings
# -----------------
# Credentials for the RabbitMQ user
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=super_secret_rabbitmq_password
# Connection URL for services (using the internal docker network hostname `rabbitmq`)
RABBITMQ_URL=amqp://admin:super_secret_rabbitmq_password@rabbitmq:5672

# -----------------
# External APIs (AI Chat)
# -----------------
# Get your API key from Groq console
GROQ_API_KEY=tu_api_key_de_groq_aqui
