# --- PORT CONFIGURATION ---
PORT_GATEWAY=80

# --- BASE DE DATOS MONGODB ---
MONGO_DB_NAME=feel-well
MONGO_AI_DB_NAME=feel-well-ai

# --- RABBITMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASS=your-secure-rabbitmq-password-here

# --- JWT CONFIGURATION ---
# Cambiar por una llave secreta de al menos 256 bits (32 caracteres) segura
JWT_SECRET=your-production-jwt-secret-at-least-32-chars-long
JWT_ISSUER=feelWell
JWT_AUDIENCE=feelWell
JWT_EXPIRES_IN=1h

# --- FRONTEND / CORS ---
# Cambiar localhost por tu dominio real si aplica
FRONTEND_URL=http://localhost
ALLOWED_ORIGINS=http://localhost

# --- EMAIL (auth-service) ---
EMAIL_PROVIDER=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# --- SEEDER DE ADMINISTRADORES (auth-service) ---
SEEDER_ADMIN_EMAIL=admin@feelwell.com
SEEDER_ADMIN_PHONE=00000000
SEEDER_ADMIN_PASSWORD=secure-admin-password-here

SEEDER_ADMIN_USERS_EMAIL=admin.users@feelwell.com
SEEDER_ADMIN_USERS_PHONE=00000000
SEEDER_ADMIN_USERS_PASSWORD=secure-users-admin-password-here

SEEDER_ADMIN_MOOD_EMAIL=admin.mood@feelwell.com
SEEDER_ADMIN_MOOD_PHONE=00000000
SEEDER_ADMIN_MOOD_PASSWORD=secure-mood-admin-password-here

SEEDER_ADMIN_HEALTHY_EMAIL=admin.healthy@feelwell.com
SEEDER_ADMIN_HEALTHY_PHONE=00000000
SEEDER_ADMIN_HEALTHY_PASSWORD=secure-healthy-admin-password-here

# --- CLOUDINARY (healthy-service) ---
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_BASE_FOLDER=https://res.cloudinary.com/your-cloudinary-cloud-name/image/upload/feel_well
CLOUDINARY_DEFAULT_AVATAR_NAME=avatar_default

# --- GROQ (ai-chat-service) ---
GROQ_API_KEY=your-groq-api-key-here
