# Levantar el stack:
#   docker compose --env-file .env.docker up --build -d

# --- BASE DE DATOS MONGODB ---
MONGO_DB_NAME=feel-well
MONGO_AI_DB_NAME=feel-well-ai
MONGODB_PORT=27017

# --- RABBITMQ (usado por mood-tracking) ---
RABBITMQ_USER=admin
RABBITMQ_PASS=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=mood.events
RABBITMQ_DLX=mood.events.dlx
RABBITMQ_PREFETCH=10
RABBITMQ_RECONNECT_DELAY_MS=1000
RABBITMQ_RECONNECT_MAX_DELAY_MS=30000
RABBITMQ_MAX_RETRIES=3

# --- PUERTOS DE SERVICIOS ---
AUTH_SERVICE_PORT=3006
AI_CHAT_SERVICE_PORT=3007
HEALTHY_SERVICE_PORT=3008
MOOD_TRACKING_PORT=3001
DAILY_POSITIVE_SERVICE_PORT=5001
CLIENT_ADMIN_PORT=5173

# --- JWT (debe coincidir en los 5 backends) ---
JWT_SECRET=change-me-min-256-bits
JWT_ISSUER=feelWell
JWT_AUDIENCE=feelWell
JWT_EXPIRES_IN=1h

# --- URLS INTERNAS DOCKER (comunicación entre contenedores) ---
DAILY_MESSAGE_URL=http://daily-positive-service:5001

# --- FRONTEND / CORS ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- URLS PARA EL FRONTEND (client-admin, resueltas desde el navegador) ---
VITE_AUTH_URL=http://localhost:3006/feelWeell/v1
VITE_AI_URL=http://localhost:3007/feelWeell/v1
VITE_HEALTHY_URL=http://localhost:3008/feelWeell/v1
VITE_MOOD_URL=http://localhost:3001/feelWeell/v1
VITE_DAILY_URL=http://localhost:5001/api/
VITE_DAILY_MESSAGE_URL=http://localhost:5001

# --- EMAIL (auth-service, envío de correos vía Gmail) ---
EMAIL_PROVIDER=gmail
EMAIL_USER=change-me@gmail.com
EMAIL_PASS=change-me-app-password

# --- SEEDER DE ADMINISTRADORES (auth-service) ---
SEEDER_ADMIN_EMAIL=admin@feelwell.com
SEEDER_ADMIN_PHONE=00000000
SEEDER_ADMIN_PASSWORD=change-me

SEEDER_ADMIN_USERS_EMAIL=admin.users@feelwell.com
SEEDER_ADMIN_USERS_PHONE=00000000
SEEDER_ADMIN_USERS_PASSWORD=change-me

SEEDER_ADMIN_MOOD_EMAIL=admin.mood@feelwell.com
SEEDER_ADMIN_MOOD_PHONE=00000000
SEEDER_ADMIN_MOOD_PASSWORD=change-me

SEEDER_ADMIN_HEALTHY_EMAIL=admin.healthy@feelwell.com
SEEDER_ADMIN_HEALTHY_PHONE=00000000
SEEDER_ADMIN_HEALTHY_PASSWORD=change-me

# --- CLOUDINARY (healthy-service, subida de imágenes) ---
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
CLOUDINARY_BASE_FOLDER=https://res.cloudinary.com/change-me/image/upload/feel_well
CLOUDINARY_DEFAULT_AVATAR_NAME=avatar_default

# --- GROQ (ai-chat-service, IA "Tiyú") ---
GROQ_API_KEY=change-me

# --- TLS ---
NODE_TLS_REJECT_UNAUTHORIZED=0
